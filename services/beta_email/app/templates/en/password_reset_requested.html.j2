{% set content %}<h1 style="color:#18332A">Reset your password</h1><p>Hello {{ ownerName }},</p><p>We received a request to reset the password for your Ferti+ account.</p><p><a href="{{ resetLink }}" style="display:inline-block;min-height:48px;line-height:48px;padding:0 24px;background:#0B6B3A;color:#fff;text-decoration:none;border-radius:6px;font-weight:bold">Reset password</a></p><p>This link works once and expires in {{ expiresInMinutes }} minutes.</p><p>If you did not ask for this, ignore this email; your password will not change.</p><p style="font-size:13px;color:#66756F">Requested: {{ requestedAt }}<br>Device: {{ deviceDescription }}<br>IP: {{ requestIp }}</p>{% endset %}{% include "layout/base.html.j2" %}
