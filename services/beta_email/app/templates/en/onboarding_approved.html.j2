{% set content %}<h1>Congratulations, {{ ownerName }}!</h1><p>Your shop <strong>{{ shopName }}</strong> is approved.</p><table role="presentation" width="100%" style="background:#F7F7F2;padding:16px"><tr><td><strong>Shop name</strong><br>{{ shopName }}</td></tr><tr><td><strong>Tenant ID</strong><br>{{ tenantId }}</td></tr><tr><td><strong>Registration reference</strong><br>{{ referenceNo }}</td></tr><tr><td><strong>Approved on</strong><br>{{ approvedAt }}</td></tr><tr><td><strong>Sign-in email</strong><br>{{ loginEmail }}</td></tr></table><p><a href="{{ signInUrl }}" style="display:inline-block;min-height:48px;line-height:48px;padding:0 24px;background:#0B6B3A;color:#fff;text-decoration:none;border-radius:6px">Sign in to Ferti+</a></p><p>Sign in with your email and password, mobile OTP, or Google.</p><h2>Quick start</h2><ol><li>Add products</li><li>Add farmers</li><li>Make your first bill</li></ol><p>Support: {{ supportEmail }}{% if helpCenterUrl %}<br><a href="{{ helpCenterUrl }}">Help centre</a>{% endif %}</p>{% endset %}{% include "layout/base.html.j2" %}
