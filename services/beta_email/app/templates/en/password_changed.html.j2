{% set content %}<h1>Your password was changed</h1><p>Hello {{ ownerName }},</p><p>Your password was changed at {{ changedAt }}. Change type: {{ changeType }}.</p><p>Device: {{ deviceDescription }}<br>IP: {{ ip }}<br>Approximate location: {{ location }}</p><p>If this was you, no action is needed. All other sessions were signed out.</p><p>If this was not you, reset your password now.</p><p><a href="{{ secureAccountLink }}" style="display:inline-block;min-height:48px;line-height:48px;padding:0 24px;background:#0B6B3A;color:#fff;text-decoration:none;border-radius:6px">Secure my account</a></p><p>Support: {{ supportEmail }}</p>{% endset %}{% include "layout/base.html.j2" %}
